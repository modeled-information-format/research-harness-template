{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-harness.dev/schema/monitoring-recommendation.schema.json",
  "title": "Continuous-Monitoring Recommendation",
  "description": "A Recommendation Engine output (research-harness-template#420): either an interest-matched candidate or a gap-detected research area. Every recommendation carries at least one citation (NFR5) -- enforced in code, not just by this schema. This is the shape the Editorial Gate (research-harness-template#422) reviews; it is not itself a MIF finding.",
  "type": "object",
  "required": ["mode", "citations"],
  "properties": {
    "mode": { "type": "string", "enum": ["interest-match", "gap-detect"] },
    "source": { "type": "string" },
    "id": { "type": "string" },
    "title": { "type": "string" },
    "url": { "type": "string" },
    "published": { "type": "string" },
    "score": { "type": "number" },
    "inference_method": { "type": "string", "enum": ["concordance", "tfidf-fallback"] },
    "dimension": { "type": "string" },
    "description": { "type": "string" },
    "finding_count": { "type": "integer" },
    "corpus_mean": { "type": "number" },
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["concordance-node", "primary-source", "internal"] },
          "target": { "type": "string" },
          "url": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
