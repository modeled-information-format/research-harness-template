#!/usr/bin/env bash
# pre-push — catch the ADR-0010 change-driven versioning gate locally before
# CI does (scripts/check-version-bump.sh, the `version-bump` CI job).
#
# Installed automatically by `npm install`'s postinstall via
# `git config core.hooksPath .githooks`. Fails closed on a real version-bump
# violation; skips (does not block the push) when the check itself cannot
# run, since CI remains the authoritative, always-enforced gate.
#
# research-harness-template#648: a release tag push (`git push origin
# vX.Y.Z`) is not a branch push, and Rule B (the release pointer must stay
# ahead of the last actual git tag release) has nothing meaningful to
# validate about the act of pushing the release tag itself — the tag being
# pushed IS the "last release" the check would resolve against, which is a
# paradox inherent to releasing, not a real versioning violation. Git invokes
# pre-push with each ref being pushed on stdin, one line per ref, in the
# standard protocol: `<local ref> SP <local sha1> SP <remote ref> SP
# <remote sha1>` (a deleted ref's local side reads literally "(delete)").
# Skip the check entirely when every ref being pushed is a tag ref
# (refs/tags/*); run it as before for any branch push, including a push that
# mixes branch and tag refs in one invocation.
set -uo pipefail

is_tag_ref() {
  case "$1" in
    refs/tags/*) return 0 ;;
    *) return 1 ;;
  esac
}

all_tags=1
saw_ref=0
if [ ! -t 0 ]; then
  # Fully drain stdin — do not `break` out early on the first non-tag ref.
  # git writes one line per ref being pushed and this hook runs `git fetch`
  # + the version check afterward; if the loop stops reading before git has
  # finished writing, the pipe buffer can fill and the push can hang. Once
  # any ref proves the push isn't tag-only, keep reading (cheaply) to EOF
  # instead of stopping.
  while read -r local_ref _local_sha remote_ref _remote_sha; do
    [ -n "${local_ref:-}" ] || continue
    saw_ref=1
    if ! is_tag_ref "$local_ref" && ! is_tag_ref "${remote_ref:-}"; then
      all_tags=0
    fi
  done
fi
# A TTY on stdin means a manual invocation with no piped refs (e.g. running
# the hook directly to test it) — there is nothing to scan and reading would
# just block, so skip the loop entirely and fall through to running the
# check as a normal (non-tag) push.

if [ "$saw_ref" -eq 1 ] && [ "$all_tags" -eq 1 ]; then
  echo "pre-push: only tag ref(s) being pushed — skipping the version-bump check (ADR-0010's Rule B has nothing meaningful to validate about pushing the release tag itself, #648)" >&2
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$ROOT" || exit 0

[ -f scripts/check-version-bump.sh ] || exit 0

git fetch origin main --quiet 2>/dev/null || true
git rev-parse --verify origin/main >/dev/null 2>&1 || exit 0

if ! command -v mif-rh-cli >/dev/null 2>&1 && [ ! -x bin/mif-rh-cli ] && [ -z "${MIF_RH_CLI:-}" ]; then
  echo "pre-push: mif-rh-cli engine not found locally, fetching it (scripts/fetch-engine.sh)..." >&2
  bash scripts/fetch-engine.sh >/dev/null 2>&1 || true
fi

# scripts/check-version-bump.sh (via scripts/lib/engine.sh's engine_bin) exits
# 5 when the engine itself is the problem (missing, non-executable, no
# version, or too old) — including a stale post-fetch state or a broken
# MIF_RH_CLI override. That is "the check could not run," not a real
# versioning violation, so it must not block the push the way exit 1 does.
bash scripts/check-version-bump.sh origin/main
status=$?

if [ "$status" -eq 0 ]; then
  exit 0
elif [ "$status" -eq 5 ]; then
  echo "pre-push: mif-rh-cli engine unavailable, skipping the local version-bump check (CI will still enforce it)" >&2
  exit 0
else
  echo "" >&2
  echo "pre-push: change-driven versioning check failed (ADR-0010) — see output above." >&2
  echo "  Fix: bump the changed component's own version (SKILL.md version: / plugin.json .version)," >&2
  echo "  and/or run 'bash scripts/bump-version.sh patch' to move the release pointer." >&2
  exit 1
fi
