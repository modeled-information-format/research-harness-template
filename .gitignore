# Astro/Starlight docs site build artifacts (package.json at repo root)
node_modules/
dist/
.astro/

# Python bytecode (the markdown hooks are plain scripts; bytecode is build cruft)
__pycache__/
*.pyc

# Codegen virtualenv (dev/build-time only; generated models under lib/ are committed)
.venv-codegen/

# Transient finding-authoring scripts agents emit (normally written to a temp dir)
author-finding*.py

# Hook runtime state
.claude/hooks/markdown/state/

# Session-scratch notes written by the /remember-style skill; not repo content
# and not markdownlint's business (see .markdownlint-cli2.jsonc's matching
# ignore) -- an active working checkout accumulates these and, uningored,
# they make the documented "0 errors" markdownlint gate go stale.
.remember/

# Instance-local materialized config — NOT template-managed and NOT byte-identical
# across instances. Rebuilt by scripts/sync-packs.sh from harness.config.json packs[],
# plus any local overrides (e.g. skillOverrides). The native `enabledPlugins` map
# lives in settings.local.json (the runtime deep-merges it with settings.json), so it
# stays out of the template-managed, byte-identical .claude/settings.json.
.claude/enabled-packs.json
.claude/settings.local.json

# NOTE: .copier-answers.yml is intentionally NOT ignored — it records the template
# commit (the merge base `copier update` needs) and must be committed in instances.

# Local-only design/upstream-proposal drafts (not shipped in the template)
docs/proposals/mif-entity-type-subsumption.md
*.json.tmp
*.tw.json
*.tmpwrite.json
*.mg
*.staging
.*.json.staging
# dimension-analyst finding-publish staging dirs (issue #357)
.staging-*/
# write-finding.sh's per-invocation staging dirs (issue #360)
.wf-staging-*/
*.fix.json
*.vb.json
reports/**/.gate_stderr*
# ADR-0011 derived run-state: non-deterministic (per-run wall-clock) status sidecar
# and the transient pre-synthesis withhold sentinel. Both are written into reports/
# at run time; committing them would dirty the tree every run and block copier update.
# (concordance.json itself stays tracked — it is deterministic and on the allowlist.)
reports/concordance-status.json
reports/**/.synthesis-withheld
# Story #324: candidate sameAs proposals -- regenerated on every import that
# writes anything (mif-container-detect-sameas.sh), not a source artifact.
reports/concordance-sameas-proposals.json

# Domain ontology packs are vendored on demand from the canonical registry
# (ADR-0012, #224); only base layers under schemas/ontologies/ ship committed.
packs/ontologies/

# The registry index sha256 pin is instance-derived, same as the packs it
# protects (ADR-0012): fetch-ontology.sh bootstraps a fresh lock on first run
# with no prior pin to conflict with. A committed lock instead freezes
# whatever the registry's live sha256 was at that commit -- every later
# `copier update` re-runs fetch-ontology.sh against this frozen pin as part
# of reconstructing the pre-update baseline, so once the live registry index
# moves even once, every future update for every instance fails closed with
# "the trust root moved", regardless of the instance's own actual pin state.
ontologies.lock.json
bin/
